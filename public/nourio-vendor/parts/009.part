  color: var(--theme-color1);
  background-size: 100% 2px;
  background-image: linear-gradient(180deg, var(--theme-color1) 0%, var(--theme-color1) 100%);
}
.blog-item-current-style2 .content .link-btn {
  display: inline-flex;
