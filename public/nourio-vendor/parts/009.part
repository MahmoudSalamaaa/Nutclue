    height: 500px;
  }
}
.projects-current-theme5:before {
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 19px;
  content: "";
  position: absolute;
  top: 20px;
  left: 20px;
  height: calc(100% - 40px);
  width: calc(100% - 40px);
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  transition: all 300ms ease;
}
.projects-current-theme5 img {
  width: 100%;
  height: 100%;
  border-radius: 30px;
  display: block;
  object-fit: cover;
  -webkit-transition: all 500ms ease;
  transition: all 500ms ease;
}
.projects-current-theme5 img:first-child {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  -webkit-transform: translateX(50%) scaleX(2);
  transform: translate(50%) scaleX(2);
  opacity: 0;
  -webkit-filter: blur(10px);
  filter: blur(10px);
}
.projects-current-theme5:hover:before {
  opacity: 1;
  visibility: visible;
}
.projects-current-theme5:hover img:first-child {
  -webkit-transform: translateX(0) scaleX(1);
  transform: translate(0) scaleX(1);
  opacity: 1;
  -webkit-filter: blur(0);
  filter: blur(0);
}
.projects-current-theme5:hover img:nth-child(2) {
  -webkit-transform: translateX(-50%) scaleX(2);
  transform: translateX(-50%) scaleX(2);
  opacity: 0;
  -webkit-filter: blur(10px);
  filter: blur(10px);
}
.projects-current-theme5:hover .content {
  clip-path: inset(0 0 0 0);
}
.projects-current-theme5 .content {
  position: absolute;
  bottom: 20px;
  left: 0px;
  margin: 0px 20px;
  background-color: var(--theme-color1);
  color: var(--theme-color1-text-color);
