    padding: 30px;
  }
}
@media (max-width: 575.98px) {
  .blog-item-current-style2 .content {
    padding: 28px 30px;
  }
}
@media (max-width: 575.98px) {
  .blog-item-current-style2 .content {
    padding: 26px 28px;
  }
}
.blog-item-current-style2 .content .entry-title {
