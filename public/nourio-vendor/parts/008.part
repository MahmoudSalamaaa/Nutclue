<style>.btn-style2 {
  display: inline-flex;
  align-items: center;
  gap: 0px;
  position: relative;
  transition: all 400ms ease;
  height: 56px;
  line-height: 56px;
  background: var(--theme-color1);
  color: var(--theme-color1-text-color);
  gap: 10px;
  border-radius: 40px;
  padding-right: 10px;
  padding-left: 30px;
}
.btn-style2:hover {
  padding-right: 38px;
