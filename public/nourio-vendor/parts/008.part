  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-color-white);
  color: var(--theme-color2);
  border-radius: 50%;
  transition: 0.4s;
  text-align: center;
}
.btn-style2 .theme-btn-arrow-left i,
.btn-style2 .theme-btn-arrow-right i {
  rotate: -30deg;
}
.btn-style2 .theme-btn-arrow-left {
  scale: 0;
  left: 0;
  right: auto;
  position: absolute;
}
